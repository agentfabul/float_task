rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- GLOBAL HARDENED HELPERS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- ENTITY VALIDATION BLUEPRINTS ---

    function isValidUserProfile(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
             (!('email' in data) || (data.email is string && data.email.size() <= 120)) &&
             (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 500));
    }

    function isValidCategory(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 40 &&
             data.color is int;
    }

    function isValidTask(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
             data.description is string && data.description.size() <= 2000 &&
             (!('categoryId' in data) || (data.categoryId is string && data.categoryId.size() <= 128)) &&
             data.priority in ['LOW', 'MEDIUM', 'HIGH', 'URGENT'] &&
             (!('dueDate' in data) || data.dueDate is int) &&
             (!('dueTime' in data) || (data.dueTime is string && data.dueTime.size() <= 10)) &&
             data.completed is bool &&
             (!('completedAt' in data) || data.completedAt is int) &&
             data.recurring is bool &&
             data.recurrencePattern in ['NONE', 'DAILY', 'WEEKLY', 'MONTHLY'] &&
             (!('subtasks' in data) || (
               data.subtasks is list &&
               data.subtasks.size() <= 30 &&
               (data.subtasks.size() == 0 || data.subtasks[0] is map)
             ));
    }

    function isValidHistoryEntry(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.taskId is string && data.taskId.size() >= 1 && data.taskId.size() <= 128 &&
             data.taskTitle is string && data.taskTitle.size() >= 1 && data.taskTitle.size() <= 200 &&
             (!('categoryName' in data) || (data.categoryName is string && data.categoryName.size() <= 40)) &&
             (!('categoryColor' in data) || data.categoryColor is int) &&
             data.priority in ['LOW', 'MEDIUM', 'HIGH', 'URGENT'] &&
             data.completedAtMillis is int;
    }

    // --- COLLECTION RULES ---

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().keys().hasAll(['userId', 'displayName', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'email', 'photoUrl', 'createdAt', 'updatedAt']) &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       isValidUserProfile(incoming());

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'photoUrl', 'updatedAt']);

      allow delete: if isOwner(userId) && isValidId(userId);

      // Categories subcollection
      match /categories/{categoryId} {
        allow get: if isOwner(userId) && isValidId(categoryId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(categoryId) &&
                         incoming().keys().hasAll(['userId', 'name', 'color', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'name', 'color', 'createdAt', 'updatedAt']) &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         isValidCategory(incoming());

        allow update: if isOwner(userId) &&
                         isValidId(categoryId) &&
                         isValidCategory(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['name', 'color', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(categoryId);
      }

      // Tasks subcollection
      match /tasks/{taskId} {
        allow get: if isOwner(userId) && isValidId(taskId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(taskId) &&
                         incoming().keys().hasAll(['userId', 'title', 'description', 'priority', 'completed', 'recurring', 'recurrencePattern', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'title', 'description', 'categoryId', 'priority', 'dueDate', 'dueTime', 'completed', 'completedAt', 'recurring', 'recurrencePattern', 'subtasks', 'createdAt', 'updatedAt']) &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         isValidTask(incoming());

        allow update: if isOwner(userId) &&
                         isValidId(taskId) &&
                         isValidTask(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         (
                           // Action: Edit task fields
                           incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'categoryId', 'priority', 'dueDate', 'dueTime', 'completed', 'completedAt', 'recurring', 'recurrencePattern', 'subtasks', 'updatedAt'])
                         );

        allow delete: if isOwner(userId) && isValidId(taskId);
      }

      // Completion History subcollection
      match /history/{historyId} {
        allow get: if isOwner(userId) && isValidId(historyId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(historyId) &&
                         incoming().keys().hasAll(['userId', 'taskId', 'taskTitle', 'priority', 'completedAtMillis', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'taskId', 'taskTitle', 'categoryName', 'categoryColor', 'priority', 'completedAtMillis', 'createdAt']) &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         isValidHistoryEntry(incoming());

        allow update: if false;

        allow delete: if isOwner(userId) && isValidId(historyId);
      }
    }
  }
}
